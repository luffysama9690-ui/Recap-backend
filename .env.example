# OpenAI API key - used for Whisper transcription + GPT-4o-mini script
# generation, and as a TTS fallback when TTS Pro (Gemini) quota is hit
OPENAI_API_KEY=sk-...

# TTS Pro backend endpoint (Myatko's existing Gemini TTS service)
TTS_PRO_URL=https://tts-pro-l6tb.onrender.com/api/generate-tts

# Port Render assigns automatically, this is just a local fallback
PORT=3000

# Comma-separated list of allowed origins for CORS (add your Vercel domain)
ALLOWED_ORIGINS=http://localhost:5173,https://recap-umber.vercel.app

# Max source video length accepted from a TikTok/RedNote/YouTube link
# (seconds). 7200 = 2 hours.
MAX_VIDEO_DURATION=7200

# Optional. YouTube blocks server-side yt-dlp requests with "Sign in to
# confirm you're not a bot" unless cookies from a logged-in browser session
# are presented. Export cookies.txt via a browser extension (e.g. "Get
# cookies.txt LOCALLY"), then base64-encode it and paste the result here.
# TikTok/RedNote don't need this — leave unset if you're not using YouTube.
# YOUTUBE_COOKIES_B64=
