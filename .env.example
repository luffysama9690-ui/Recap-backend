# OpenAI API key - used for Whisper transcription + GPT-4o-mini script
# generation, and as a TTS fallback when TTS Pro (Gemini) quota is hit
OPENAI_API_KEY=sk-...

# TTS Pro backend endpoint (Myatko's existing Gemini TTS service)
TTS_PRO_URL=https://tts-pro-l6tb.onrender.com/api/generate-tts

# Port Render assigns automatically, this is just a local fallback
PORT=3000

# Comma-separated list of allowed origins for CORS (add your Vercel domain)
ALLOWED_ORIGINS=http://localhost:5173,https://recap-umber.vercel.app

# Max source video length accepted from a TikTok/RedNote link (seconds).
# Same 4-minute MVP cap as direct uploads.
MAX_VIDEO_DURATION=240
